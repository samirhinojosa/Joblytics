# ====================================================
# Joblytics Analytics Pipeline - Environment Setup
# ====================================================
# Copy this file to .env and replace the placeholder values.
# DO NOT commit the actual .env file to version control (.gitignore).

# --- Execution Environment ---
# APP_ENV: 'local', 'staging', or 'production'
APP_ENV="local"
LOG_LEVEL="DEBUG"

# --- Snowflake Configuration (dbt / Python) ---
SNOWFLAKE_ACCOUNT="your_account"                    # Your Snowflake account identifier
SNOWFLAKE_USER="your_user"                          # Snowflake username
SNOWFLAKE_PASSWORD="your_password_here"             # Snowflake password
SNOWFLAKE_ROLE="ACCOUNTADMIN"                       # Active role (e.g., SYSADMIN, ACCOUNTADMIN)
SNOWFLAKE_WAREHOUSE="DEMO_WH"                       # Compute Warehouse for dbt and scrapers

# --- Target Databases and Schemas ---
# Target database where dbt will create analytical models (Staging, DWH, Gold, Exposition)
SNOWFLAKE_ANALYTICS_DATABASE="ANALYTICS_DB"
SNOWFLAKE_ANALYTICS_SCHEMA="STAGING"                          # Default schema for dbt connection

# Source database (Bronze / Raw) where the Python scraper lands raw JSONs
SNOWFLAKE_RAW_DATABASE="RAW_DB"
SNOWFLAKE_RAW_SCHEMA="LINKEDIN"
